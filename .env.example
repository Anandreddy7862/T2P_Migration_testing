# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env
# ---------------------------------------------------------------------------

# ----- Tableau -------------------------------------------------------------
TABLEAU_BASE_URL=https://prod-apnortheast-a.online.tableau.com
TABLEAU_USERNAME=your.user@company.com
TABLEAU_PASSWORD=change-me
# tableau-cloud | tableau-server | tableau-public
TABLEAU_AUTH_TYPE=tableau-cloud
TABLEAU_SITE=my-site

# Sign in on this url - a dashboard url lands on the right site/tenant.
# QUOTE IT. Tableau view urls contain '#', which starts a comment in a .env
# file, so an unquoted value is silently truncated at the '#' - you end up on
# the pod root and Tableau then asks "Tell us where to sign in".
TABLEAU_START_URL="https://prod-in-a.online.tableau.com/#/site/<site>/views/<workbook>/<view>"

# ----- Tableau data source --------------------------------------------------
# Answered into Tableau's "Sign in to reconnect" dialog - the account the
# workbook's LIVE connection uses (Snowflake here). This is NOT the Tableau
# login: without it every visual renders "No data to visualise with current
# filters" and the extraction downloads empty CSVs.
TABLEAU_DATASOURCE_USERNAME=
TABLEAU_DATASOURCE_PASSWORD=
# true ticks "Remember Password", so Tableau stores the credential against the
# user account server-side and stops asking on later runs. Off by default -
# it changes account state, not just this browser session.
TABLEAU_DATASOURCE_REMEMBER_PASSWORD=false

# ----- Power BI ------------------------------------------------------------
POWERBI_BASE_URL=https://app.powerbi.com
POWERBI_USERNAME=your.user@company.com
POWERBI_PASSWORD=change-me
POWERBI_START_URL=
# How long a headed run may wait for a human to complete MFA
MFA_WAIT_MS=180000

# ----- Execution -----------------------------------------------------------
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=60000
NAV_TIMEOUT=90000
DOWNLOAD_TIMEOUT=180000
RETRIES=1
WORKERS=1
TRACE=retain-on-failure

# ----- Comparison tolerances ----------------------------------------------
# absolute/relative tolerance for numeric cell comparison
NUMERIC_TOLERANCE=0.01
NUMERIC_TOLERANCE_PCT=0.001
# ignore row ordering differences between platforms
IGNORE_ROW_ORDER=true
# ignore case + whitespace when matching column headers
NORMALIZE_HEADERS=true
# fail the test on the first mismatching visual (false = collect all)
FAIL_FAST=false

# ----- Paths ---------------------------------------------------------------
DOWNLOAD_DIR=downloads
REPORT_DIR=artifacts/reports
